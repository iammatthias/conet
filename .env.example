# CONET deployment configuration. Nothing here is secret: neither service holds
# capability material and neither decrypts. Copy to .env and fill in.

# Bind address for published ports. Leave as the loopback default for local use.
# On the homelab this must be the docker bridge gateway (172.17.0.1), because
# caddy runs in a container and reaches the host through host.docker.internal.
# A service bound to 127.0.0.1 there is invisible to ingress while looking
# perfectly healthy from inside the box.
BIND_IP=127.0.0.1

# Host port the tuner publishes. The indexers publish nothing and are reached
# over the compose network as http://indexer:3100, http://indexer-1:3100 and
# http://indexer-4663:3100.
CONET_TUNER_PORT=8900

# RPC for the indexer and tuner. publicnode serves head, calls, and log scans
# near the head without limits; it refuses log scans more than about 100 blocks
# behind head, and when that happens the indexer walks the gap block by block
# through eth_getBlockReceipts on the same endpoint, at a couple of blocks a
# second. History lives in the index, so nothing reads it from an RPC twice.
# A brand-new index from the deployment block walks the whole distance that
# way; point this at https://mainnet.base.org for that first pass if speed
# matters.
CONET_RPC_URL=https://base-rpc.publicnode.com
CONET_CHAIN_ID=8453
CONET_FACTORY_ADDRESS=0xB084351e5Fd70d318a2264Bc8af63C4575Db8844
CONET_FACTORY_BLOCK=50801478

# The same factory is live on Ethereum and Robinhood Chain, and the tuner tunes
# them too. Each has its own indexer in compose with its own database under
# ./data; deployment blocks and explorers come from web/src/server/deployments.ts.
# Ethereum needs a keyed RPC; the URL carries the key, so set it on the box
# only. Alchemy's free tier serves eth_getLogs over at most 10 blocks, so
# Ethereum's scan window is capped there for the indexer and the tuner's RPC
# fallback.
CONET_RPC_URL_1=
CONET_MAX_BLOCK_RANGE_1=10
CONET_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
CONET_MAX_BLOCK_RANGE_4663=100000
CONET_MAX_LAG_BLOCKS_4663=2400

# Block explorer origin for the primary chain's links. Defaults from the chain id
# for the chains it knows; set it to override,
# or on a chain with no known explorer to add one. Must be an https origin.
# STATION_EXPLORER_URL=https://basescan.org

# Origins allowed to embed the tuner with <conet-tuner> from /embed.js. Only
# these get cross-origin access to the /_tuner/* fragments, GET only, no
# credentials. Comma-separated origins with no path; empty disables it. Add a
# plain http:// dev-server origin to preview an embedding site before deploy.
CONET_EMBED_ORIGINS=https://iammatthias.com

# Largest eth_getLogs window; halves on provider error and recovers on success.
CONET_MAX_BLOCK_RANGE=2000

# Starting addresses per request when a provider refuses topic-only log scans;
# halves whenever the provider rejects the list as too large.
CONET_ADDRESS_CHUNK=100

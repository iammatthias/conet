{
  "name": "@conet/tuner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch server.ts",
    "dev:client": "vite",
    "build": "vite build && vite build -c vite.embed.config.ts",
    "start": "bun server.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test src && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
